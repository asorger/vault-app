# Auto detect text files and perform LF normalization
* text=auto

# Explicit text files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Explicit binary files (never convert line endings or corrupt bytes)
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text
*.vault binary
*.db binary
*.dat binary
*.wasm binary
